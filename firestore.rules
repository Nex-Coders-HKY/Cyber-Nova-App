rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }

    // Certificates: no public access. Admins manage them. A student can read only the
    // certificates assigned to their own account (studentUid == their uid).
    match /certificates/{certId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.get('studentUid', null) == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Enrollment applications from the public site. Anyone can submit a valid pending record.
    // Only admins can read or manage applications.
    match /applications/{appId} {
      allow create: if request.resource.data.keys().hasOnly(['fullName','firstName','lastName','email','phone','city','courseId','courseName','fee','experience','status','createdAt'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() BETWEEN 2 AND 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('.+@.+\\..+')
        && request.resource.data.phone is string && request.resource.data.phone.size() BETWEEN 7 AND 25
        && request.resource.data.courseName is string && request.resource.data.courseName.size() BETWEEN 1 AND 120
        && request.resource.data.fee is number && request.resource.data.fee >= 0
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Student profiles: a student can read their own record. Only admins (via server) write.
    match /students/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
